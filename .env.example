# Personal values live in the gitignored repo-root .env; copy this file
# there and fill it in.

# Hugging Face org hosting the keeper policy repos (the schema-2 deploy
# pairs). Read from the environment; the training tools also read the
# repo-root .env directly (wojtek_rl/paths.py), so exporting it is only
# needed for the ROS launches.
HF_ORGANIZATION=

# Hugging Face token with read access to the keeper repos (they are
# private). Read natively by huggingface_hub; `hf auth login` works too,
# in which case leave this empty.
HF_TOKEN=

# WandB entity (team or user) for training runs. Read natively by wandb;
# empty means the account's default entity. The project name is Hydra
# config (`wandb.project`), not an env value.
WANDB_ENTITY=

# Policy reference override for sim/demo tools: HF repo id, local export
# dir, or a path to policy.npz. Empty means the HF_ORGANIZATION default
# (see wojtek_rl/paths.py). The ROS sim launch reads it too, over the pin
# in wojtek_policy/policy_source.py, but only as a Hugging Face reference,
# org/name[@rev]: sim.sh / dev.sh carry it into the container, which
# cannot see host paths, so they drop a directory or an npz path here.
# Give a ROS launch a directory with policy:= instead. The robot never
# reads this variable.
WOJTEK_POLICY=

# The VLM brain's model server: Ollama serving qwen3-vl:30b-a3b-instruct,
# a base URL, e.g. http://HOST:11434 (with or without /v1). Two consumers:
# the ROS VLM brain (`./ros/sim.sh ... vlm:=true`,
# `ros2 run wojtek_bringup robot --vlm`; ros/sim.sh copies it into the
# container) and the training demo (`run.sh room`). Empty means
# http://127.0.0.1:11434. On the GPU box: `ollama pull
# qwen3-vl:30b-a3b-instruct` and `ollama serve`.
# Ollama answers only on its own machine, so from another PC either tunnel
# to it (`ssh -f -N -L 11435:127.0.0.1:11434 <gpu box>`; the URL is then
# the PC's port 11435) or start it with OLLAMA_HOST=0.0.0.0:11434, which
# opens it to the whole network with no password. Inside a ros/ container
# the PC's own ports are reached differently on the two systems:
#   macOS: Docker Desktop puts the container on a bridge network, and it
#   reaches the Mac by the name host.docker.internal:
#     VLM_URL=http://host.docker.internal:11435
#   Linux: the container shares the PC's network, so the tunnel is on its
#   own loopback (host.docker.internal does not exist there):
#     VLM_URL=http://127.0.0.1:11435
# The training demo runs on the PC itself and uses http://127.0.0.1:<port>.
VLM_URL=
# The Ollama model tag, when it is not the default qwen3-vl:30b-a3b-instruct.
VLM_MODEL=

# The DGX <-> Wojtek link (experiments/wojtek_link/run.sh): the robot's
# foxglove_bridge and the camera Pi's, ws://<address>:8765. The relay on
# the DGX reads the robot from the first and the pictures from the second.
WOJTEK_BRIDGE_URL=
WOJTEK_CAMERA_URL=

# Set to 1 on a host whose Docker multicast loopback is broken (seen on a
# headless GPU box: `ros2 node list` hangs and nodes in one container never
# find each other). sim.sh / dev.sh carry it into the container. Leave it
# empty on a PC that must reach the robot over the network: with it set,
# the container talks to nobody but itself.
ROS_LOCALHOST_ONLY=
