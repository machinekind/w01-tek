# Personal cluster values — copy to .env (gitignored) and fill in yours.
# One file, two consumers:
#   - Makefile (-include .env): composes the ssh/rsync destination for
#     the make hpc-* targets; `make hpc-push` also rsyncs .env to the
#     cluster checkout.
#   - training/hpc/_common.sh (load_env): SLURM jobs read the cluster
#     checkout's .env for any variable not already exported; an explicit
#     `sbatch --export` or shell export always wins.
# Plain KEY=VALUE lines only: no quotes, no spaces, no inline comments
# (the same file is parsed by both make and bash).

# cluster ssh destination (the account is shared).
cluster_USER=user@ui.cluster.example

# Your namespace dir under $HOME on the shared account — never point
# this at someone else's.
HPC_NS=kowalski

# Checkout dir name inside the namespace.
HPC_REPO=wojtek

# Persistent per-person dir on grant storage for the training venv, JAX
# compile cache, and offline wandb. Create your own subdir; never reuse
# someone else's (the venv bootstrap would rewrite their pins).
STORE_DIR=/CLUSTER_PATH
