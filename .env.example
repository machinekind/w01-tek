# Personal values live in the gitignored repo-root .env; copy this file
# there and fill it in.

# Hugging Face org hosting the keeper policy repos (the schema-2 deploy
# pairs). Read from the environment; the training tools also read the
# repo-root .env directly (wojtek_rl/paths.py), so exporting it is only
# needed for the ROS launches.
HF_ORGANIZATION=

# Hugging Face token with read access to the keeper repos (they are
# private). Read natively by huggingface_hub; `hf auth login` works too,
# in which case leave this empty.
HF_TOKEN=

# WandB entity (team or user) for training runs. Read natively by wandb;
# empty means the account's default entity. The project name is Hydra
# config (`wandb.project`), not an env value.
WANDB_ENTITY=

# Policy reference override for sim/demo tools: HF repo id, local export
# dir, or a path to policy.npz. Empty means the HF_ORGANIZATION default
# (see wojtek_rl/paths.py). The ROS launches read it too (sim.sh / dev.sh
# carry it into the container): a schema-2 pair, org/name[@rev] or a
# directory, over the pin in wojtek_policy/policy_source.py.
WOJTEK_POLICY=

# The VLM model server, a base URL, e.g. http://HOST:8000 (with or without
# /v1). Two consumers: the ROS VLM brain (`./ros/sim.sh ... vlm:=true`,
# `ros2 run wojtek_bringup robot --vlm`; ros/sim.sh copies it into the
# container) and the training demo (`run.sh room`, where empty selects the
# built-in default backend). ros/src/wojtek_nav/scripts/serve_vlm.sh starts
# the server on the GPU box: vLLM with Qwen3-VL-8B-Instruct on port 8000.
VLM_URL=
# API key for that endpoint, if it has one ("EMPTY" is the vLLM default).
VLLM_API_KEY=
# The model name as that server knows it, when it is not the brain's default
# (Qwen/Qwen3-VL-8B-Instruct): a vLLM --served-model-name, an Ollama tag.
VLM_MODEL=
