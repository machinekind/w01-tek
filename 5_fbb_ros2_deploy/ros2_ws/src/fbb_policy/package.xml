<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>fbb_policy</name>
  <version>0.1.0</version>
  <description>
    RL locomotion policy runner for four_bar_bot: MuJoCo simulation with RViz
    visualization, and the same policy wired to the real robot through
    ros2_control (MD80 impedance + BMX160 IMU).
  </description>
  <maintainer email="michalpogoda@surferseo.com">Michal Pogoda</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2_ros</depend>
  <depend>four_bar_bot_description</depend>

  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
