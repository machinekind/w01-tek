<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>wojtek_agent_msgs</name>
  <version>0.1.0</version>
  <description>
    Message definitions for Wojtek's agentic voice/brain pipeline: audio
    chunks, transcripts, routed intents and reply sentences. The graph and
    QoS contracts are documented in docs/plans/agentic-ros2.md.
  </description>
  <maintainer email="maciejgruszczynski@surferseo.com">Maciej Gruszczynski</maintainer>
  <license>Apache License 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>std_msgs</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
