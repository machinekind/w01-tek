{
  "configById": {
    "3D!wojtek": {
      "cameraState": {
        "perspective": true,
        "distance": 1.6,
        "phi": 60,
        "thetaOffset": 45,
        "targetOffset": [0, 0, 0],
        "target": [0, 0, 0],
        "targetOrientation": [0, 0, 0, 1],
        "fovy": 45,
        "near": 0.01,
        "far": 5000
      },
      "followMode": "follow-pose",
      "followTf": "base_link",
      "scene": {
        "transforms": { "showLabel": false, "axisScale": 0.5 }
      },
      "transforms": {
        "frame:odom": { "visible": true },
        "frame:base_link": { "visible": true }
      },
      "topics": {
        "/robot_description": { "visible": true },
        "/tf": { "visible": true }
      },
      "layers": {
        "grid": {
          "layerId": "foxglove.Grid",
          "visible": true,
          "frameId": "odom",
          "size": 10,
          "divisions": 20,
          "color": "#444444"
        }
      },
      "publish": { "type": "point", "poseTopic": "/move_base_simple/goal", "pointTopic": "/clicked_point", "poseEstimateTopic": "/initialpose" }
    },
    "Image!color": {
      "imageMode": { "imageTopic": "/camera/camera/color/image_raw", "calibrationTopic": "/camera/camera/color/camera_info" },
      "cameraState": { "distance": 20 }
    },
    "Image!depth": {
      "imageMode": { "imageTopic": "/camera/camera/depth/image_rect_raw", "calibrationTopic": "/camera/camera/depth/camera_info" },
      "cameraState": { "distance": 20 }
    },
    "Plot!vel": {
      "title": "Velocity (odom ground truth)",
      "paths": [
        { "value": "/odom_vel.linear.x", "enabled": true, "timestampMethod": "receiveTime", "label": "vx [m/s]" },
        { "value": "/odom_vel.linear.y", "enabled": true, "timestampMethod": "receiveTime", "label": "vy [m/s]" },
        { "value": "/odom_vel.angular.z", "enabled": true, "timestampMethod": "receiveTime", "label": "wz [rad/s]" },
        { "value": "/cmd_vel.linear.x", "enabled": true, "timestampMethod": "receiveTime", "label": "cmd vx [m/s]" }
      ],
      "showXAxisLabels": true,
      "showYAxisLabels": true,
      "showLegend": true,
      "legendDisplay": "floating",
      "showPlotValuesInLegend": true,
      "isSynced": true,
      "xAxisVal": "timestamp",
      "sidebarDimension": 240,
      "followingViewWidth": 30,
      "minYValue": -1,
      "maxYValue": 1
    },
    "RawMessages!nav": {
      "topicPath": "/wojtek/nav_command",
      "diffTopicPath": "",
      "diffMethod": "custom",
      "diffEnabled": false,
      "showFullMessageForDiff": false,
      "expansion": "all"
    },
    "RawMessages!pose": {
      "topicPath": "/tf",
      "diffTopicPath": "",
      "diffMethod": "custom",
      "diffEnabled": false,
      "showFullMessageForDiff": false,
      "expansion": "all"
    }
  },
  "globalVariables": {},
  "userNodes": {},
  "playbackConfig": { "speed": 1 },
  "layout": {
    "direction": "row",
    "first": {
      "direction": "column",
      "first": "Image!color",
      "second": {
        "direction": "row",
        "first": "Image!depth",
        "second": "RawMessages!nav",
        "splitPercentage": 60
      },
      "splitPercentage": 55
    },
    "second": {
      "direction": "column",
      "first": "3D!wojtek",
      "second": "Plot!vel",
      "splitPercentage": 65
    },
    "splitPercentage": 40
  }
}
