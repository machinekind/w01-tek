# Copy to `.env` (gitignored) and fill in. deploy.sh sources this at provision
# time. NEVER commit the real .env.
#
#   cp .env.example .env && $EDITOR .env
#
# This file is for the robot's own secrets and overrides. What the whole
# repository shares -- HF_ORGANIZATION, WOJTEK_ROBOT, HF_TOKEN -- lives in
# the repo-root .env (see ../.env.example); deploy.sh reads that one too.

# Ubuntu Pro token for enabling the realtime kernel on the RPi.
# Get it (free, personal, up to 5 machines) from https://ubuntu.com/pro/dashboard.
# Only the RPi needs this; the PC/dev side never does (it runs in Docker).
# Used non-interactively: `pro attach $UBUNTU_PRO_TOKEN`.
UBUNTU_PRO_TOKEN=

# Optional overrides (else deploy.sh defaults apply):
# RPI_HOST=rpi@10.42.0.2

# WPA2 passphrase for the robot's own AP (wojtek-link). install.sh
# substitutes it into hostapd.conf at provision time; never committed.
WOJTEK_AP_PSK=

# The Steam Deck that runs the wojtek_deck panel (ros/deck.sh). All optional:
# without them deck.sh finds the Deck by looking for the one host on your
# subnet answering on the ssh port. Its address is on DHCP and moves.
#DECK_HOST=user@address
#DECK_USER=deck
#DECK_SSH_PORT=2222
