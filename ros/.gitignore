# ROS 2 colcon workspace. Repo-wide patterns are in ../.gitignore.

# colcon build output
/build/
/install/
/log/

# from wojtek_ws
build/
install/
log/
__pycache__/
*.pyc
.env
deploy/rpi/cache/

# Per-run rosbags recorded by the launch files (bag_dir default is ~/wojtek_bags,
# but dev.sh's container mounts them here -- see docker/compose.yaml).
/bags/

# Generated room scene (training: ./run.sh build-room)
/src/wojtek_description/mujoco/scene_room.xml
/src/wojtek_description/mujoco/scene_apartment.xml

# Generated terrain arenas (training: ./run.sh build-terrain [--arena KIND]).
# One file set per kind: train (unsuffixed), eval, test -- see paths.py.
/src/wojtek_description/mujoco/scene_terrain.xml
/src/wojtek_description/mujoco/scene_terrain_*.xml
/src/wojtek_description/mujoco/terrain_hfield.bin
/src/wojtek_description/mujoco/terrain_spec.json
/src/wojtek_description/mujoco/terrain_lookup.npz
/src/wojtek_description/mujoco/terrain_*_hfield.bin
/src/wojtek_description/mujoco/terrain_*_spec.json
/src/wojtek_description/mujoco/terrain_*_lookup.npz

# The policy store and the deploy-written override file. This repo is
# public and the policy repos are private, so neither may be committed.
/policies/
/policy_override

# The deck panel's detector assets: the YOLOX network and the
# onnxruntime-web runtime the page downloads. Fetched by
# src/wojtek_deck/fetch_assets.sh -- other people's binaries, tens of
# megabytes, so they are downloaded rather than committed.
/deck_assets/

.policies/

