  "globalVariables": {},
  "userNodes": {},
  "playbackConfig": {
    "speed": 1
  },
  "layout": {
    "direction": "row",
    "splitPercentage": 45,
    "first": {
      "direction": "column",
      "splitPercentage": 34,
      "first": "Plot!soctemp",
      "second": {
        "direction": "column",
        "splitPercentage": 40,
        "first": "StateTransitions!throttle",
        "second": "Plot!cpu"
      }
    },
    "second": {
      "direction": "column",
      "splitPercentage": 50,
      "first": {
        "direction": "column",
        "splitPercentage": 50,
        "first": "Plot!timing",
        "second": "Plot!cmdvel"
      },
      "second": {
        "direction": "column",
        "splitPercentage": 40,
        "first": "Plot!joints",
        "second": {
          "direction": "column",
          "splitPercentage": 50,
          "first": "Plot!imu",
          "second": "machinekind.wojtek-console-panel.Wojtek console!console"
        }
      }
    }
  }
}
