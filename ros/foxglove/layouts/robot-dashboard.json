{
  "configById": {
    "Plot!soctemp": {
      "title": "SoC temperature (C)",
      "paths": [
        {
          "value": "/wojtek/sysinfo.soc_temp_c",
          "enabled": true,
          "timestampMethod": "receiveTime"
        }
      ],
      "xAxisVal": "timestamp",
      "isSynced": true,
      "showLegend": true,
      "legendDisplay": "floating",
      "showXAxisLabels": true,
      "showYAxisLabels": true,
      "followingViewWidth": 60
    },
    "StateTransitions!throttle": {
      "title": "Throttling",
      "paths": [
        {
          "value": "/wojtek/sysinfo.undervoltage_now",
          "timestampMethod": "receiveTime"
        },
        {
          "value": "/wojtek/sysinfo.undervoltage_ever",
          "timestampMethod": "receiveTime"
        },
        {
          "value": "/wojtek/sysinfo.throttled_now",
          "timestampMethod": "receiveTime"
        },
        {
          "value": "/wojtek/sysinfo.throttled_ever",
          "timestampMethod": "receiveTime"
        },
        {
          "value": "/wojtek/sysinfo.freq_capped_now",
          "timestampMethod": "receiveTime"
        },
        {
          "value": "/wojtek/sysinfo.freq_capped_ever",
          "timestampMethod": "receiveTime"
        }
      ],
      "isSynced": true
    },
    "Plot!cpu": {
      "title": "CPU per core (%) and load",
      "paths": [
        {
          "value": "/wojtek/sysinfo.cpu_percent[:]",
          "enabled": true,
          "timestampMethod": "receiveTime"
        },
        {
          "value": "/wojtek/sysinfo.load1",
          "enabled": true,
          "timestampMethod": "receiveTime"
        }
      ],
      "xAxisVal": "timestamp",
      "isSynced": true,
      "showLegend": true,
      "legendDisplay": "floating",
      "showXAxisLabels": true,
      "showYAxisLabels": true,
      "followingViewWidth": 60
    },
    "Plot!timing": {
