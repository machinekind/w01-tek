          "timestampMethod": "receiveTime"
        },
        {
          "value": "/imu_sensor_broadcaster/imu.angular_velocity.z",
          "enabled": true,
          "timestampMethod": "receiveTime"
        },
        {
          "value": "/imu_sensor_broadcaster/imu.linear_acceleration.x",
          "enabled": true,
          "timestampMethod": "receiveTime"
        },
        {
          "value": "/imu_sensor_broadcaster/imu.linear_acceleration.y",
          "enabled": true,
          "timestampMethod": "receiveTime"
        },
        {
          "value": "/imu_sensor_broadcaster/imu.linear_acceleration.z",
          "enabled": true,
          "timestampMethod": "receiveTime"
