<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>bmi160_serial_hardware_interface</name>
  <version>0.0.0</version>
  <description>
    ros2_control sensor hardware interface for a bare BMI160 (accel+gyro,
    no magnetometer) over serial, for use in place of
    bmx160_serial_hardware_interface when only a BMI160 is available.
  </description>
  <maintainer email="kchmielewski707@gmail.com">Jakub Chmielewski</maintainer>
  <!-- The C++ package is Apache-2.0; the Arduino sketches under firmware/
       link GPL AHRS code and stay GPL - see firmware/LICENSE.md. -->
  <license>Apache License 2.0</license>
  <license file="firmware/LICENSE.md">GPL</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_gmock</test_depend>
  <test_depend>ros2_control_test_assets</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
