<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>magnetometer_broadcaster</name>
  <version>0.1.0</version>
  <description>ros2_control broadcaster publishing magnetometer.{x,y,z} state interfaces as sensor_msgs/MagneticField (upstream imu_sensor_broadcaster has no magnetometer support)</description>
  <maintainer email="kchmielewski707@gmail.com">Jakub Chmielewski</maintainer>
  <license>Apache License 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>controller_interface</depend>
  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>realtime_tools</depend>
  <depend>sensor_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
