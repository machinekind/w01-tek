<?xml version="1.0"?>
<!--
  Real-robot URDF for running the RL policy.

  Mechanically identical to four_bar_bot_description's four_bar_bot.urdf.xacro
  (same leg macros), but the ros2_control block differs:
    * command interface `position` -> MD80 IMPEDANCE mode
    * impedance gains kp/kd and max_torque default to the values the policy
      was trained against (kp=20, kd=1, +/-6 Nm). Override via xacro args
      for cautious first tests, e.g. max_torque:=2
    * the BMX160 IMU ros2_control sensor is instantiated (it is commented out
      in the original description).
-->
<robot name="quadruped" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find four_bar_bot_description)/urdf/body.urdf.xacro" />
  <xacro:include filename="$(find piesek_bringup)/urdf/fbb_ros2_control.urdf.xacro" />

  <xacro:arg name="kp" default="20.0" />
  <xacro:arg name="kd" default="1.0" />
  <xacro:arg name="max_torque" default="6.0" />
  <xacro:arg name="usb_port" default="/dev/ttyACM0" />
  <!-- Loaner BMI160 (no magnetometer) until the real BMX160 is sourced;
       see bmi160_serial_hardware_interface. Swap back to
       xacro:fbb_imu_ros2_control below once the real sensor is back.
       by-id path instead of /dev/ttyUSBx: the CP2102 drops off the bus on
       a flaky cable and can re-enumerate under a different number; the
       by-id symlink always points at the current node (the container mounts
       the host's /dev, so the symlink stays live). -->
  <xacro:arg name="imu_port"
    default="/dev/serial/by-id/usb-Silicon_Labs_CP2102_USB_to_UART_Bridge_Controller_0001-if00-port0" />

  <xacro:four_bar_bot_body />

  <xacro:fbb_ros2_control kp="$(arg kp)" kd="$(arg kd)" max_torque="$(arg max_torque)"
    usb_port="$(arg usb_port)" />
  <!-- IMU disabled: flaky BMI160 and fbb_loco_v8 doesn't observe it.
       Re-enable (with the imu_sensor_broadcaster in real_controllers.yaml
       and real.launch.py) before running an IMU-observing policy.
  <xacro:fbb_bmi160_imu_ros2_control port="$(arg imu_port)" />
  -->
</robot>
