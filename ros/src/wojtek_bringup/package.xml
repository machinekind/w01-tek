<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>wojtek_bringup</name>
  <version>0.1.0</version>
  <description>
    Robot-side bringup for wojtek: launches wojtek_policy against the real
    robot (MD80 + IMU through ros2_control). Deliberately free of GUI/sim
    dependencies so the RPi build stays lean -- RViz/PlotJuggler/teleop/MuJoCo
    live in wojtek_viz (PC-side).
  </description>
  <maintainer email="kchmielewski707@gmail.com">Jakub Chmielewski</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2_ros</depend>
  <depend>python3-numpy</depend>
  <depend>wojtek_policy</depend>
  <depend>wojtek_description</depend>
  <depend>md80_hardware_interface</depend>
  <depend>bmx160_serial_hardware_interface</depend>
  <depend>bmi160_serial_hardware_interface</depend>
  <depend>imu_i2c_hardware_interface</depend>
  <depend>magnetometer_broadcaster</depend>

  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>ros2_controllers</exec_depend>
  <!-- Each run records a full rosbag (ros2 bag record -a); see robot.launch.py. -->
  <exec_depend>ros2bag</exec_depend>
  <exec_depend>rosbag2_transport</exec_depend>
  <exec_depend>rosbag2_storage_default_plugins</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
