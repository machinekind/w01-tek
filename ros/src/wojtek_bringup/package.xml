<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>wojtek_bringup</name>
  <version>0.1.0</version>
  <description>
    Robot-side bringup for wojtek: launches wojtek_policy against the real
    robot (MD80 + IMU through ros2_control). Deliberately free of GUI/sim
    dependencies so the RPi build stays lean -- RViz/PlotJuggler/teleop/MuJoCo
    live in wojtek_pc (PC-side).
  </description>
  <maintainer email="kchmielewski707@gmail.com">Jakub Chmielewski</maintainer>
  <license>Apache License 2.0</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2_ros</depend>
  <depend>python3-numpy</depend>
  <depend>wojtek_policy</depend>
  <depend>wojtek_description</depend>
  <!-- Robot-side pad teleop: an exec_depend keeps it inside deploy.sh's
       "packages-up-to wojtek_bringup" build, so gamepad:=true has the
       node available on the RPi. -->
  <exec_depend>wojtek_teleop</exec_depend>
  <!-- Camera pipeline (perception:=true). Same reason as wojtek_teleop: the
       exec_depend is what pulls it into deploy.sh's "packages-up-to
       wojtek_bringup" build, so the RPi has it at all. -->
  <exec_depend>wojtek_perception_bringup</exec_depend>
  <!-- Hardware plugins and the sensor broadcaster: pluginlib loads them at
       runtime from the name in the URDF, and this package is ament_python, so
       it compiles nothing against them. Exec, not build: a build dependency
       drags md80's vendored candle (CMake add_subdirectory) into every PC
       build that touches this package, including the simulation, which needs
       none of it. deploy.sh's "packages-up-to wojtek_bringup" still carries
       exec_depends, so the RPi gets the drivers exactly as before (same
       mechanism as wojtek_teleop above). Verify with a colcon list run in
       "packages up to wojtek_bringup" mode: these five must still show up. -->
  <exec_depend>md80_hardware_interface</exec_depend>
  <exec_depend>imu_i2c_hardware_interface</exec_depend>
  <exec_depend>magnetometer_broadcaster</exec_depend>
  <!-- Retired serial IMUs (superseded by imu_i2c_hardware_interface); still
       built for the robot until the packages themselves go. -->
  <exec_depend>bmx160_serial_hardware_interface</exec_depend>
  <exec_depend>bmi160_serial_hardware_interface</exec_depend>

  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>ros2_controllers</exec_depend>
  <!-- Each run records a full rosbag (ros2 bag record -a); see robot.launch.py. -->
  <exec_depend>ros2bag</exec_depend>
  <exec_depend>rosbag2_transport</exec_depend>
  <exec_depend>rosbag2_storage_default_plugins</exec_depend>
  <!-- sysinfo_node runs in every bringup (launch_common.py). wojtek_policy
       already pulls it in for the messages, but this launch starts the node
       itself. -->
  <exec_depend>wojtek_telemetry</exec_depend>
  <!-- foxglove:=true, the default on the robot, starts the bridge on port
       8765 so a Foxglove session watches the robot with no PC in the loop.
       A build without the package launches without the bridge. -->
  <exec_depend>foxglove_bridge</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
