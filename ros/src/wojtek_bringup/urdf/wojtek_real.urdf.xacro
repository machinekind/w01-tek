<?xml version="1.0"?>
<!--
  Real-robot URDF for running the RL policy.

  Mechanically identical to wojtek_description's wojtek.urdf.xacro
  (same leg macros), but the ros2_control block differs:
    * command interface `position` -> MD80 IMPEDANCE mode
    * impedance gains kp/kd and max_torque default to the values the policy
      was trained against (kp=20, kd=1, +/-6 Nm). Override via xacro args
      for cautious first tests, e.g. max_torque:=2
    * the BMX160 IMU ros2_control sensor is instantiated (it is commented out
      in the original description).
-->
<robot name="quadruped" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find wojtek_description)/urdf/body.urdf.xacro" />
  <xacro:include filename="$(find wojtek_bringup)/urdf/wojtek_ros2_control.urdf.xacro" />

  <xacro:arg name="kp" default="20.0" />
  <xacro:arg name="kd" default="1.0" />
  <xacro:arg name="max_torque" default="6.0" />
  <!-- CAN link to the MD80s: CANdle HAT over SPI by default (drives flashed
       to 8M). bus:=usb can_baud:=1 falls back to the old USB dongle; only
       works if the drives are flashed back to 1M. -->
  <xacro:arg name="bus" default="spi" />
  <xacro:arg name="can_baud" default="8" />
  <xacro:arg name="usb_port" default="/dev/ttyACM0" />
  <!-- The serial IMU (loaner BMI160 behind an MCU + CP2102 bridge) was retired
       2026-07-17 in favor of the Adafruit 5543 (LSM6DS3TR-C + LIS3MDL) wired
       straight to the Pi's I2C1; its ros2_control interface does not exist
       yet, so use_imu defaults to false and the whole IMU component is left
       out (with the serial hardware gone, configuring it aborts the entire
       ros2_control_node). Flip to true only with the CP2102 stack physically
       reconnected. -->
  <xacro:arg name="use_imu" default="false" />
  <xacro:arg name="imu_port"
    default="/dev/serial/by-id/usb-Silicon_Labs_CP2102_USB_to_UART_Bridge_Controller_0001-if00-port0" />

  <xacro:wojtek_body />

  <xacro:wojtek_ros2_control kp="$(arg kp)" kd="$(arg kd)" max_torque="$(arg max_torque)"
    usb_port="$(arg usb_port)" bus="$(arg bus)" can_baud="$(arg can_baud)" />
  <xacro:if value="$(arg use_imu)">
    <xacro:wojtek_bmi160_imu_ros2_control port="$(arg imu_port)" />
  </xacro:if>
</robot>
