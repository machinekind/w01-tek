<?xml version="1.0"?>
<!--
  Real-robot URDF for running the RL policy.

  Mechanically identical to wojtek_description's wojtek.urdf.xacro
  (same leg macros), but the ros2_control block differs:
    * command interface `position` -> MD80 IMPEDANCE mode
    * impedance gains kp/kd and max_torque default to the values the shipped
      policy was trained against (kp=40, kd=1.6, +/-9 Nm; the pd block in
      wojtek_policy/config/policy_meta.json). Override via xacro args for
      cautious first tests, e.g. max_torque:=2
    * the IMU I2C ros2_control sensor is instantiated when use_imu:=true (it
      is commented out in the original description).
-->
<robot name="quadruped" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find wojtek_description)/urdf/body.urdf.xacro" />
  <xacro:include filename="$(find wojtek_bringup)/urdf/wojtek_ros2_control.urdf.xacro" />

  <xacro:arg name="kp" default="40.0" />
  <xacro:arg name="kd" default="1.6" />
  <xacro:arg name="max_torque" default="9.0" />
  <!-- CAN link to the MD80s: CANdle HAT over SPI by default (drives flashed
       to 8M). bus:=usb can_baud:=1 falls back to the old USB dongle; only
       works if the drives are flashed back to 1M. -->
  <xacro:arg name="bus" default="spi" />
  <xacro:arg name="can_baud" default="8" />
  <xacro:arg name="usb_port" default="/dev/ttyACM0" />
  <!-- Bench mode: drives are never enabled (no torque at all), encoder
       states still stream. Set by the launches from their dry_run arg. -->
  <xacro:arg name="dry_run" default="false" />
  <!-- The serial IMU (loaner BMI160 behind an MCU + CP2102 bridge) was retired
       2026-07-17 in favor of the Adafruit 5543 (LSM6DS3TR-C + LIS3MDL) wired
       straight to the Pi's I2C1 (imu_i2c_hardware_interface). On by default;
       use_imu:=false brings the stack up with the sensor absent/unwired. -->
  <xacro:arg name="use_imu" default="true" />
  <xacro:arg name="imu_bus" default="/dev/i2c-1" />
  <xacro:arg name="imu_addr_ag" default="0x6A" />
  <xacro:arg name="imu_addr_mag" default="0x1C" />

  <xacro:wojtek_body />

  <xacro:wojtek_ros2_control kp="$(arg kp)" kd="$(arg kd)" max_torque="$(arg max_torque)"
    usb_port="$(arg usb_port)" bus="$(arg bus)" can_baud="$(arg can_baud)"
    dry_run="$(arg dry_run)" />
  <xacro:if value="$(arg use_imu)">
    <xacro:wojtek_imu_i2c_ros2_control bus="$(arg imu_bus)" addr_ag="$(arg imu_addr_ag)"
      addr_mag="$(arg imu_addr_mag)" />
  </xacro:if>
</robot>
