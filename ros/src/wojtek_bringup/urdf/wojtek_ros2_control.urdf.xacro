<?xml version="1.0"?>
<robot name="quadruped" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- position command interface => MD80 IMPEDANCE mode; the drive runs
       tau = kp*(q_target - q) - kd*dq clamped to max_torque, which is
       exactly the actuator model the policy was trained with
       (wojtek_mjx.xml: gainprm=20, biasprm="0 -20 -1", forcerange 6)
       when kp=20, kd=1, max_torque=6. -->
  <xacro:macro name="wojtek_joint" params="name can_id kp kd max_torque">
    <joint name="${name}">
      <command_interface name="position" />
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="effort">
        <param name="initial_value">0.0</param>
      </state_interface>

      <param name="can_id">${can_id}</param>
      <param name="max_torque">${max_torque}</param>

      <!-- q_/dq_ PID params are required by the driver's URDF parser but
           unused in IMPEDANCE mode; ddq_kp/ddq_kd are the impedance gains. -->
      <param name="q_kp">10.0</param>
      <param name="q_ki">0.5</param>
      <param name="q_kd">0.0</param>
      <param name="q_windup">1.0</param>
      <param name="dq_kp">2.0</param>
      <param name="dq_ki">0.5</param>
      <param name="dq_kd">0.0</param>
      <param name="dq_windup">0.1</param>
      <param name="ddq_kp">${kp}</param>
      <param name="ddq_kd">${kd}</param>
    </joint>
  </xacro:macro>

  <!-- bus: "spi" = CANdle HAT on the Pi header (device defaults to
       /dev/spidev0.0 inside the driver), "usb" = the legacy CANdle dongle at
       usb_port. can_baud (Mbps) must match the drives' flashed baudrate:
       8 since the 2026-07-17 migration for the HAT; the dongle setup ran 1.
       See ros/hw_tests/README.md for the per-drive baud migration tool. -->
  <xacro:macro name="wojtek_ros2_control" params="kp kd max_torque usb_port bus:=spi can_baud:=8 dry_run:=false">
    <ros2_control name="MD80HardwareInterface" type="system">
      <hardware>
        <plugin>md80_hardware_interface/MD80HardwareInterface</plugin>
        <param name="usb_port">${usb_port}</param>
        <param name="bus">${bus}</param>
        <param name="can_baud">${can_baud}</param>
        <!-- true = bench mode: drives never enabled (no torque), encoder
             states still stream. Wired from the launches' dry_run arg. -->
        <param name="dry_run">${dry_run}</param>
      </hardware>

      <xacro:wojtek_joint name="front_left_first_joint" can_id="10" kp="${kp}" kd="${kd}" max_torque="${max_torque}" />
      <xacro:wojtek_joint name="front_left_second_joint" can_id="11" kp="${kp}" kd="${kd}" max_torque="${max_torque}" />
      <xacro:wojtek_joint name="front_left_third_joint" can_id="12" kp="${kp}" kd="${kd}" max_torque="${max_torque}" />

      <xacro:wojtek_joint name="front_right_first_joint" can_id="20" kp="${kp}" kd="${kd}" max_torque="${max_torque}" />
      <xacro:wojtek_joint name="front_right_second_joint" can_id="21" kp="${kp}" kd="${kd}" max_torque="${max_torque}" />
      <xacro:wojtek_joint name="front_right_third_joint" can_id="22" kp="${kp}" kd="${kd}" max_torque="${max_torque}" />

      <xacro:wojtek_joint name="rear_right_first_joint" can_id="30" kp="${kp}" kd="${kd}" max_torque="${max_torque}" />
      <xacro:wojtek_joint name="rear_right_second_joint" can_id="31" kp="${kp}" kd="${kd}" max_torque="${max_torque}" />
      <xacro:wojtek_joint name="rear_right_third_joint" can_id="32" kp="${kp}" kd="${kd}" max_torque="${max_torque}" />

      <xacro:wojtek_joint name="rear_left_first_joint" can_id="40" kp="${kp}" kd="${kd}" max_torque="${max_torque}" />
      <xacro:wojtek_joint name="rear_left_second_joint" can_id="41" kp="${kp}" kd="${kd}" max_torque="${max_torque}" />
      <xacro:wojtek_joint name="rear_left_third_joint" can_id="42" kp="${kp}" kd="${kd}" max_torque="${max_torque}" />
    </ros2_control>
  </xacro:macro>

  <!-- Adafruit 5543 (LSM6DS3TR-C + LIS3MDL) straight on the Pi's I2C bus:
       no MCU/firmware bridge, no onboard fusion. orientation.* carries the
       quaternion from the driver's error-state Kalman filter (gyro
       prediction + accel roll/pitch + mag yaw, orientation_eskf.hpp); it
       reads (0,0,0,0) only until the filter sees its first accel+mag pair,
       which wojtek_policy treats as "no fusion yet" and bridges with its
       own complementary filter. mag_calib_file points at the ellipsoid
       calibration produced by ros/hw_tests/imu_i2c/mag_calib.py (the
       shipped default is an identity placeholder; usable, uncalibrated).
       addr_ag/addr_mag default to the board's un-jumpered addresses; bump
       to 0x6B/0x1E if SDO is pulled high. See ros/hw_tests/imu_i2c for the
       bench test this register map/init sequence was validated against. -->
  <xacro:macro name="wojtek_imu_i2c_ros2_control" params="bus:=/dev/i2c-1 addr_ag:=0x6A addr_mag:=0x1C mag_calib_file:='$(find wojtek_bringup)/config/mag_calib.yaml'">
    <ros2_control name="imu" type="sensor">
      <hardware>
        <plugin>imu_i2c_hardware_interface/ImuI2CHardwareInterface</plugin>
        <param name="bus">${bus}</param>
        <param name="addr_ag">${addr_ag}</param>
        <param name="addr_mag">${addr_mag}</param>
        <param name="mag_calib_file">${mag_calib_file}</param>
      </hardware>
      <sensor name="imu">
        <state_interface name="orientation.x" />
        <state_interface name="orientation.y" />
        <state_interface name="orientation.z" />
        <state_interface name="orientation.w" />
        <state_interface name="magnetometer.x" />
        <state_interface name="magnetometer.y" />
        <state_interface name="magnetometer.z" />
        <state_interface name="angular_velocity.x" />
        <state_interface name="angular_velocity.y" />
        <state_interface name="angular_velocity.z" />
        <state_interface name="linear_acceleration.x" />
        <state_interface name="linear_acceleration.y" />
        <state_interface name="linear_acceleration.z" />
      </sensor>
    </ros2_control>
  </xacro:macro>
</robot>
