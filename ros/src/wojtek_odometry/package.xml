<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>wojtek_odometry</name>
  <version>0.1.0</version>
  <description>
    Leg-kinematics + IMU odometry: base velocity from the stance-leg
    Jacobians fused with the IMU orientation, integrated into a planar
    odom pose for Nav2.
  </description>
  <maintainer email="piotrowskigrzegorz2000@gmail.com">Grzegorz Piotrowski</maintainer>
  <license>Apache License 2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <!-- PASSIVE_FROM_KNEE (four-bar closure) and the joint order live there;
       this package deliberately has no second copy of either. -->
  <exec_depend>wojtek_policy</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
