<!--
  The simulation's world: the training scene plus a few things to look at.

  scene_mjx.xml is an empty checkerboard floor, which is what a walking
  policy needs and nothing else. The deck panel runs an object detector on
  the robot's camera picture, and on an empty floor it has nothing to find,
  so this file adds a handful of props around the spawn: a ball, a fire
  hydrant, a traffic light, a stop sign, a clock, and a person standing off
  in the distance. Each one was chosen by rendering it and asking the panel's
  own YOLOX-nano what it saw; the ones that survived are named confidently
  from one to three metres away (the person from about five).

  This is the file BOTH halves of the simulation load -- the physics plugin
  inside ros2_control and the camera node that draws the picture -- so the
  props are solid: the robot bumps into them instead of walking through. They
  are static bodies with no joints, so the generalized position the plugin
  publishes has exactly the same layout it had without them, and nothing
  about the robot, the policy or the training model changes. The training
  scene is included, never edited: scene_mjx.xml and wojtek_mjx.xml are
  generated by ./training/run.sh build.

  A prop's own +x points at its face, so a prop is turned toward the spawn by
  giving its body a yaw of atan2(-y, -x). The two signs wear a picture from
  props/ (see props/make_textures.py); everything else is plain colour, which
  is all the detector needs.

  Heights are not free. The camera sits about 0.21 m off the floor and looks
  15 degrees down, so at two metres the top of the picture is only 0.75 m up
  and anything taller is cut off. Everything here is short on purpose, which
  is also why the person stands far enough back to fit in the frame.
-->
<mujoco model="wojtek_sim_scene">
  <include file="scene_mjx.xml"/>

  <compiler texturedir="props"/>

  <!-- A brighter, flatter light than the training scene's. The props are
       small and far from the lens; under the darker default they came out as
       silhouettes and the detector lost several of them. -->
  <visual>
    <headlight diffuse="0.45 0.45 0.45" ambient="0.55 0.55 0.55" specular="0.1 0.1 0.1"/>
  </visual>

  <asset>
    <texture type="2d" name="stop_face" file="stop_sign.png"/>
    <material name="stop_face" texture="stop_face"/>
    <texture type="2d" name="clock_face" file="clock.png"/>
    <material name="clock_face" texture="clock_face"/>
    <!-- A ball is a ball because of the panels on it, not the colour. -->
    <texture type="2d" name="ball_skin" builtin="checker" mark="cross"
             rgb1="1 1 1" rgb2="0.9 0.35 0.05" markrgb="0.1 0.1 0.1"
             width="128" height="128"/>
    <!-- texuniform is what wraps the pattern around a sphere; without it the
         panels come out as one flat patch and the ball stops being a ball. -->
    <material name="ball_skin" texture="ball_skin" texuniform="true" texrepeat="2 2"/>
    <material name="prop_post" rgba="0.55 0.56 0.58 1"/>
    <material name="prop_dark" rgba="0.12 0.12 0.14 1"/>
    <material name="prop_hydrant" rgba="0.85 0.12 0.10 1"/>
    <!-- emission so the lamps read as lit rather than as painted discs -->
    <material name="lamp_red" rgba="0.95 0.15 0.1 1" emission="0.7"/>
    <material name="lamp_amber" rgba="0.98 0.7 0.1 1" emission="0.7"/>
    <material name="lamp_green" rgba="0.15 0.9 0.3 1" emission="0.7"/>
    <material name="prop_skin" rgba="0.85 0.68 0.55 1"/>
    <material name="prop_hair" rgba="0.22 0.16 0.12 1"/>
    <material name="prop_shirt" rgba="0.30 0.42 0.72 1"/>
    <material name="prop_trousers" rgba="0.2 0.2 0.25 1"/>
  </asset>

  <worldbody>
    <!-- One sun so the props have a lit side and a shaded one. No shadows:
         they cost render time and the detector does not need them. -->
    <light name="prop_sun" directional="true" castshadow="false"
           pos="2 2 5" dir="-0.35 -0.35 -1" diffuse="0.8 0.78 0.72"/>

    <!-- Group 2 is the visible group; contype/conaffinity on the load-bearing
         shape of each prop is what makes it solid. The trimmings (lamps,
         faces, hands) are visual only, so the contact list stays short. -->

    <body name="prop_ball" pos="1.60 0.58 0">
      <geom name="prop_ball_geom" type="sphere" size="0.11" pos="0 0 0.11"
            material="ball_skin" contype="1" conaffinity="15" group="2"/>
    </body>

    <body name="prop_hydrant" pos="2.10 -1.30 0">
      <geom name="prop_hydrant_body" type="cylinder" size="0.115 0.23" pos="0 0 0.23"
            material="prop_hydrant" contype="1" conaffinity="15" group="2"/>
      <geom name="prop_hydrant_dome" type="sphere" size="0.115" pos="0 0 0.46"
            material="prop_hydrant" contype="0" conaffinity="0" group="2"/>
      <geom name="prop_hydrant_bonnet" type="cylinder" size="0.06 0.05" pos="0 0 0.57"
            material="prop_hydrant" contype="0" conaffinity="0" group="2"/>
      <geom name="prop_hydrant_cap_l" type="cylinder" size="0.06 0.05" pos="0 0.14 0.30"
            euler="1.5708 0 0" material="prop_hydrant" contype="0" conaffinity="0" group="2"/>
      <geom name="prop_hydrant_cap_r" type="cylinder" size="0.06 0.05" pos="0 -0.14 0.30"
            euler="1.5708 0 0" material="prop_hydrant" contype="0" conaffinity="0" group="2"/>
      <geom name="prop_hydrant_nose" type="cylinder" size="0.05 0.05" pos="0.14 0 0.30"
            euler="0 1.5708 0" material="prop_hydrant" contype="0" conaffinity="0" group="2"/>
      <geom name="prop_hydrant_flange" type="cylinder" size="0.15 0.025" pos="0 0 0.025"
            material="prop_hydrant" contype="0" conaffinity="0" group="2"/>
    </body>

    <body name="prop_traffic_light" pos="0.90 -3.10 0" euler="0 0 1.8534">
      <geom name="prop_traffic_post" type="cylinder" size="0.025 0.14" pos="0 0 0.14"
            material="prop_post" contype="1" conaffinity="15" group="2"/>
      <geom name="prop_traffic_case" type="box" size="0.055 0.09 0.20" pos="0 0 0.46"
            material="prop_dark" contype="1" conaffinity="15" group="2"/>
      <geom name="prop_traffic_red" type="cylinder" size="0.055 0.008" pos="0.058 0 0.59"
            euler="0 1.5708 0" material="lamp_red" contype="0" conaffinity="0" group="2"/>
      <geom name="prop_traffic_amber" type="cylinder" size="0.055 0.008" pos="0.058 0 0.46"
            euler="0 1.5708 0" material="lamp_amber" contype="0" conaffinity="0" group="2"/>
      <geom name="prop_traffic_green" type="cylinder" size="0.055 0.008" pos="0.058 0 0.33"
            euler="0 1.5708 0" material="lamp_green" contype="0" conaffinity="0" group="2"/>
    </body>

    <body name="prop_stop_sign" pos="1.72 2.46 0" euler="0 0 -2.1810">
      <geom name="prop_stop_post" type="cylinder" size="0.022 0.10" pos="0 0 0.10"
            material="prop_post" contype="1" conaffinity="15" group="2"/>
      <geom name="prop_stop_plate" type="box" size="0.018 0.31 0.31" pos="0 0 0.40"
            material="stop_face" contype="1" conaffinity="15" group="2"/>
    </body>

    <body name="prop_clock" pos="-2.35 0.86 0" euler="0 0 -0.3508">
      <geom name="prop_clock_post" type="cylinder" size="0.022 0.10" pos="0 0 0.10"
            material="prop_post" contype="1" conaffinity="15" group="2"/>
      <geom name="prop_clock_plate" type="box" size="0.018 0.25 0.25" pos="0 0 0.38"
            material="clock_face" contype="1" conaffinity="15" group="2"/>
    </body>

    <!-- Far enough back that the whole figure fits in the frame; a person
         two metres away is legs and nothing else, and reads as no one. -->
    <body name="prop_person" pos="6.48 0.57 0" euler="0 0 -3.0539">
      <geom name="prop_person_torso" type="capsule" size="0.15" fromto="0 0 0.95 0 0 1.35"
            material="prop_shirt" contype="1" conaffinity="15" group="2"/>
      <geom name="prop_person_head" type="sphere" size="0.105" pos="0 0 1.53"
            material="prop_skin" contype="0" conaffinity="0" group="2"/>
      <geom name="prop_person_hair" type="sphere" size="0.098" pos="-0.02 0 1.57"
            material="prop_hair" contype="0" conaffinity="0" group="2"/>
      <geom name="prop_person_neck" type="capsule" size="0.045" fromto="0 0 1.38 0 0 1.44"
            material="prop_skin" contype="0" conaffinity="0" group="2"/>
      <geom name="prop_person_arm_l" type="capsule" size="0.055" fromto="0 0.19 1.33 0 0.23 0.92"
            material="prop_shirt" contype="0" conaffinity="0" group="2"/>
      <geom name="prop_person_arm_r" type="capsule" size="0.055" fromto="0 -0.19 1.33 0 -0.23 0.92"
            material="prop_shirt" contype="0" conaffinity="0" group="2"/>
      <geom name="prop_person_hand_l" type="sphere" size="0.045" pos="0 0.235 0.87"
            material="prop_skin" contype="0" conaffinity="0" group="2"/>
      <geom name="prop_person_hand_r" type="sphere" size="0.045" pos="0 -0.235 0.87"
            material="prop_skin" contype="0" conaffinity="0" group="2"/>
      <geom name="prop_person_leg_l" type="capsule" size="0.075" fromto="0 0.09 0.88 0 0.10 0.08"
            material="prop_trousers" contype="1" conaffinity="15" group="2"/>
      <geom name="prop_person_leg_r" type="capsule" size="0.075" fromto="0 -0.09 0.88 0 -0.10 0.08"
            material="prop_trousers" contype="1" conaffinity="15" group="2"/>
      <geom name="prop_person_shoe_l" type="box" size="0.11 0.05 0.03" pos="0.04 0.10 0.03"
            material="prop_dark" contype="0" conaffinity="0" group="2"/>
      <geom name="prop_person_shoe_r" type="box" size="0.11 0.05 0.03" pos="0.04 -0.10 0.03"
            material="prop_dark" contype="0" conaffinity="0" group="2"/>
    </body>
  </worldbody>
</mujoco>
