<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>wojtek_policy</name>
  <version>0.1.0</version>
  <description>
    RL locomotion policy for wojtek: the pure-numpy trained-policy
    runtime and the ROS node wrapping it (observations in, joint targets
    out). Backend-agnostic - see wojtek_bringup for real-robot/MuJoCo launch.
  </description>
  <maintainer email="michalpogoda@surferseo.com">Michal Pogoda</maintainer>
  <license>Apache License 2.0</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2_ros</depend>
  <depend>python3-numpy</depend>
  <!-- policy_node reports its per-tick timing as a PolicyTiming message. -->
  <depend>wojtek_telemetry</depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
