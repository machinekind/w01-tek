<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>wojtek_viz</name>
  <version>0.1.0</version>
  <description>
    Visualization, debugging and MuJoCo simulation for wojtek: RViz,
    PlotJuggler and teleop for the live robot, plus the MuJoCo sim node.
    PC-side only -- deliberately kept out of wojtek_bringup so the robot
    (RPi) build never needs GUI/simulation dependencies.
  </description>
  <maintainer email="kchmielewski707@gmail.com">Jakub Chmielewski</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2_ros</depend>
  <depend>python3-numpy</depend>
  <depend>wojtek_policy</depend>
  <depend>wojtek_description</depend>

  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>plotjuggler</exec_depend>
  <exec_depend>teleop_twist_keyboard</exec_depend>
  <!-- mujoco is a pip package (no reliable rosdep key); installed via pip,
       see docker/Dockerfile. Only mujoco_sim_node needs it. -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
