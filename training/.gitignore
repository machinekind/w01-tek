# MJX + Brax PPO training project. Repo-wide patterns are in ../.gitignore.

# Caches
.jax_cache/
.pytest_cache/
.ruff_cache/

# Generated / large artifacts
/runs/
/videos/
/pose_previews/
/outputs/

# Room-scan artifacts (recreated by ./run.sh room-assets + build-room);
# only the LICENSE/attribution file is tracked.
/assets/room/raw/
/assets/room/processed/
/assets/room/manifest.json
/assets/room/occupancy.npz
# Named scan scenes (recreated by room-assets --name X + build-room --name X
# + grid --name X); objects.json is hand-authored and stays tracked.
/assets/scenes/*/raw/
/assets/scenes/*/processed/
/assets/scenes/*/manifest.json
/assets/scenes/*/occupancy.npz
/assets/scenes/*/LICENSE.md

# Trained policies — published to HuggingFace, not tracked in git
/policies/

# Experiment tracking
/wandb/
